<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cyj.xx.mapper.SectionsMapper">

    <select id="PageHotSec" resultType="com.cyj.xx.dvo.HotSectionsDVO">
        SELECT
            id,name,image,followers_count,post_count
        from sections
        ORDER BY followers_count DESC
    </select>

<!--    <select id="getMySection" resultType="com.cyj.xx.dvo.MySectionDVO">-->
<!--        -->
<!--    </select>-->
    <update id="UpdateSection" parameterType="com.cyj.xx.entity.Section">
        UPDATE sections
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
            <if test="backgroundImage != null">
                background_image = #{backgroundImage},
            </if>
            <if test="followersCount != null">
                followers_count = #{followersCount},
            </if>
            <if test="adminId != null">
                admin_id = #{adminId},
            </if>
            <if test="postCount != null">
                post_count = #{postCount},
            </if>
            <if test="image != null">
                image = #{image},
            </if>
            updated_time = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>



</mapper>